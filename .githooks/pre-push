#!/usr/bin/env bash
# Last check before anything leaves the machine: every blob, path, commit message and
# author/committer name in all local refs, plus gitleaks over the full history.
set -euo pipefail
root=$(git rev-parse --show-toplevel)
cd "$root"
python3 scripts/leak_guard.py --require-denylist --history
gitleaks git --no-banner --redact -c .gitleaks.toml .
bad=$(git log --all --format='%ae%n%ce' | sort -u | grep -v -E '@users\.noreply\.github\.com$|^noreply@(github|anthropic)\.com$' || true)
if [ -n "$bad" ]; then echo "pre-push: a commit carries a non-noreply email; fix git config user.email first." >&2; exit 1; fi
