#!/usr/bin/env bash
# Keep Claude Code memory and Codex instructions in sync across machines via
# a PRIVATE git repo. Safe to run often (hooks, timers): idempotent, never
# exits non-zero, never blocks for long.
#
# CODE = the folder your repos live in (AGENT_MEMORY_CODE_DIR, default ~/github)
#   memory/            <- ~/.claude/projects/<enc CODE>/memory
#   projects/home/     <- ~/.claude/projects/<enc $HOME>/memory
#   projects/<name>/   <- ~/.claude/projects/<enc CODE>-<name>/memory
#   rules/shared.md    -> imported by ~/.claude/CLAUDE.md, copied into ~/.codex/AGENTS.md
set -u
CODE=${AGENT_MEMORY_CODE_DIR:-$HOME/github}
REPO=${AGENT_MEMORY_DIR:-$CODE/agent-memory}
HOST=${AGENT_MEMORY_HOST:-$(hostname -s)}
PROJECTS=$HOME/.claude/projects
LOCK=$REPO/.git/agent-memory-sync.lock
export GIT_TERMINAL_PROMPT=0 GIT_SSH_COMMAND=${GIT_SSH_COMMAND:-"ssh -o BatchMode=yes -o ConnectTimeout=10"}

log(){ echo "agent-memory-sync: $*" >&2; }
[ -d "$REPO/.git" ] || { log "no repo at $REPO"; exit 0; }

# one run at a time; a stale lock (>10 min) is broken
if ! mkdir "$LOCK" 2>/dev/null; then
  if [ -n "$(find "$LOCK" -maxdepth 0 -mmin +10 2>/dev/null)" ]; then rm -rf "$LOCK"; mkdir "$LOCK" 2>/dev/null || exit 0
  else exit 0; fi
fi
trap 'rm -rf "$LOCK"' EXIT

g(){ git -C "$REPO" "$@"; }

# Fold a local memory dir into its repo slot, then replace it with a symlink.
link_dir(){
  local src=$1 slot=$REPO/$2 f base stem
  [ -L "$src" ] && return 0
  mkdir -p "$slot"
  if [ -d "$src" ]; then
    for f in "$src"/*; do
      [ -f "$f" ] || continue
      base=$(basename "$f")
      if [ "$base" = MEMORY.md ]; then
        touch "$slot/MEMORY.md"
        grep -vxF -f "$slot/MEMORY.md" "$f" >> "$slot/MEMORY.md" || true
      elif [ ! -e "$slot/$base" ]; then
        cp -p "$f" "$slot/$base"
      elif ! cmp -s "$f" "$slot/$base"; then
        stem=${base%.md}
        cp -p "$f" "$slot/$stem.from-$HOST.md"
        printf -- '- [%s (from %s, reconcile)](%s.from-%s.md) — local copy that differed from the shared one\n' \
          "$stem" "$HOST" "$stem" "$HOST" >> "$slot/MEMORY.md"
      fi
    done
    mv "$src" "$src.pre-sync.$(date +%Y%m%d%H%M%S)"
  fi
  ln -s "$slot" "$src"
}

link_all(){
  local enc code d name
  enc=$(printf '%s' "$HOME" | sed 's/[^A-Za-z0-9]/-/g')
  code=$(printf '%s' "$CODE" | sed 's/[^A-Za-z0-9]/-/g')
  [ -d "$PROJECTS" ] || return 0
  for d in "$PROJECTS"/*/; do
    name=$(basename "$d")
    case "$name" in
      "$code") link_dir "$PROJECTS/$name/memory" memory ;;
      "$enc") link_dir "$PROJECTS/$name/memory" projects/home ;;
      "$code-"*) link_dir "$PROJECTS/$name/memory" "projects/${name#"$code-"}" ;;
    esac
  done
}

commit_local(){
  g add -A -- memory projects rules 2>/dev/null
  g diff --cached --quiet || g commit -qm "memory: sync from $HOST" >/dev/null
}

gen_codex(){
  [ -d "$HOME/.codex" ] || return 0
  local out=$HOME/.codex/AGENTS.md tmp
  tmp=$(mktemp) || return 0
  {
    echo "<!-- Generated by agent-memory-sync from $REPO. Edit rules/shared.md there, not this file. -->"
    echo
    [ -f "$REPO/rules/shared.md" ] && cat "$REPO/rules/shared.md"
    echo
    [ -f "$REPO/rules/codex-memory.md" ] && cat "$REPO/rules/codex-memory.md"
    echo
    echo "Memory index path: $REPO/memory/MEMORY.md"
  } > "$tmp"
  if cmp -s "$tmp" "$out"; then rm -f "$tmp"; else mv "$tmp" "$out"; fi
}

link_all
commit_local
if g pull -q --rebase --autostash origin main >/dev/null 2>&1; then
  g push -q origin HEAD:main >/dev/null 2>&1 || log "push failed (offline?)"
else
  g rebase --abort >/dev/null 2>&1
  log "pull failed (offline or conflict); local commits kept"
fi
gen_codex
exit 0
